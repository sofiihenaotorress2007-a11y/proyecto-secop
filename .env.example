# Plantilla de variables de entorno para el servicio de PostgreSQL.
#
# Este archivo (.env.example) SI se versiona en Git: no tiene credenciales
# reales, solo la lista de variables que el proyecto necesita.
#
# Antes de levantar el proyecto, copie este archivo a ".env" (sin ".example")
# y reemplace los valores. El archivo ".env" real NUNCA se sube a Git
# (ya esta listado en .gitignore).
#
#   cp .env.example .env

POSTGRES_USER=secop_user
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=secop_db

# Host y puerto que usara Jupyter para conectarse al contenedor de Postgres.
# "db" es el nombre del servicio en docker-compose.yml, no "localhost":
# los contenedores se hablan entre si por nombre de servicio en la red
# interna que Docker Compose crea automaticamente.
POSTGRES_HOST=db
POSTGRES_PORT=5432
