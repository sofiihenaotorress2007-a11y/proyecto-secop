# Plantilla de variables de entorno para el servicio de PostgreSQL.
#
# Este archivo (.env.example) SI se versiona en Git: no tiene credenciales
# reales, solo la lista de variables que el proyecto necesita.
#
# Antes de levantar el proyecto, copie este archivo a ".env" (sin ".example")
# y reemplace los valores. El archivo ".env" real NUNCA se sube a Git
# (ya esta listado en .gitignore).
#
#   cp .env.example .env

POSTGRES_USER=secop_user
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=secop_db

# Host y puerto que usara Jupyter para conectarse al contenedor de Postgres.
# "db" es el nombre del servicio en docker-compose.yml, no "localhost":
# los contenedores se hablan entre si por nombre de servicio en la red
# interna que Docker Compose crea automaticamente.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Lago de datos (MinIO, sesion 5) ---
# Credenciales del almacenamiento de objetos. La guia de la sesion usa
# "minioadmin/minioadmin" como ejemplo didactico; aqui van en .env, nunca
# hardcodeadas en docker-compose.yml ni en el codigo, por la misma razon
# que las de Postgres (ver docs/decision_frontera_contenedor.md).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cambiar_esta_clave

# Extremo de la API S3 de MinIO. El puerto 9000 estandar de la guia ya lo
# ocupa hdfs-namenode (RPC de HDFS) en este proyecto, asi que la API de
# MinIO se publica en el 9002 del host (ver lago-equipo/docker-compose.yml).
# Desde el host (scripts corridos directamente en la maquina) es
# localhost:9002. Desde otro contenedor Docker Desktop (ej. el de
# Jupyter, en una red distinta a la del lago) se usa
# host.docker.internal:9002, que resuelve al host.
MINIO_ENDPOINT=http://localhost:9002
