# Configuracion compartida del cluster HDFS.
# CORE_CONF_fs_defaultFS le dice a todos los nodos donde esta el namenode.
CORE_CONF_fs_defaultFS=hdfs://namenode:9000

# NIVEL 2: experimento con factor de replica = 2 (antes era 3)
HDFS_CONF_dfs_replication=2

# NIVEL 2: experimento con tamano de bloque = 8 MB (antes 128 MB, el default de HDFS)
# 8 MB = 8388608 bytes. Con esto, un archivo de 36 MB SI se parte en varios bloques.
HDFS_CONF_dfs_blocksize=8388608

# Permite operar el namenode sin permisos estrictos de usuario,
# util solo para un entorno de practica local, nunca en produccion.
HDFS_CONF_dfs_permissions_enabled=false

# --------------------------------------------------------------------
# COMO USAR ESTE ARCHIVO:
# Para reproducir el experimento del Nivel 2, renombra este archivo a
# "hadoop.env" (reemplazando el de Nivel 1) y corre:
#   docker compose down -v
#   docker compose up -d
# El "-v" es obligatorio: HDFS no permite cambiar el tamano de bloque
# de un sistema de archivos que ya tiene datos.
# --------------------------------------------------------------------
