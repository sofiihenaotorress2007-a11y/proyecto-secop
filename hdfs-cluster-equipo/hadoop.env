# Configuracion compartida del cluster HDFS.
# CORE_CONF_fs_defaultFS le dice a todos los nodos donde esta el namenode.
CORE_CONF_fs_defaultFS=hdfs://namenode:9000

# Factor de replica por defecto. Empezamos en 3 (el valor tipico de HDFS)
# para observar el comportamiento estandar antes de cambiarlo en el Nivel 2.
HDFS_CONF_dfs_replication=3

# Permite operar el namenode sin permisos estrictos de usuario,
# util solo para un entorno de practica local, nunca en produccion.
HDFS_CONF_dfs_permissions_enabled=false

# Extension YARN (Sesion 4): gestor de recursos, gestor de nodos e historial.
YARN_CONF_yarn_resourcemanager_hostname=resourcemanager
CORE_CONF_hadoop_http_staticuser_user=root
MAPRED_CONF_mapreduce_framework_name=yarn

# Sin esto el ApplicationMaster no encuentra MRAppMaster en el classpath
# (fallo real observado: "Could not find or load main class
# org.apache.hadoop.mapreduce.v2.app.MRAppMaster"). No esta en la guia base.
YARN_CONF_yarn_app_mapreduce_am_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1
YARN_CONF_mapreduce_map_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1
YARN_CONF_mapreduce_reduce_env=HADOOP_MAPRED_HOME=/opt/hadoop-3.2.1

# Sin esto el nodemanager no expone el servicio de shuffle y el job falla con
# "InvalidAuxServiceException: The auxService:mapreduce_shuffle does not
# exist" (fallo real observado). Tampoco esta en la guia base.
YARN_CONF_yarn_nodemanager_aux___services=mapreduce_shuffle
YARN_CONF_yarn_nodemanager_aux___services_mapreduce_shuffle_class=org.apache.hadoop.mapred.ShuffleHandler
