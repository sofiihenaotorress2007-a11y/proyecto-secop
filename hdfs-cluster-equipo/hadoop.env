# Configuracion compartida del cluster HDFS.
# CORE_CONF_fs_defaultFS le dice a todos los nodos donde esta el namenode.
CORE_CONF_fs_defaultFS=hdfs://namenode:9000

# Factor de replica por defecto. Empezamos en 3 (el valor tipico de HDFS)
# para observar el comportamiento estandar antes de cambiarlo en el Nivel 2.
HDFS_CONF_dfs_replication=3

# Permite operar el namenode sin permisos estrictos de usuario,
# util solo para un entorno de practica local, nunca en produccion.
HDFS_CONF_dfs_permissions_enabled=false
